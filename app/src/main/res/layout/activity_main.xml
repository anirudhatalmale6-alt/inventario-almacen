<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Inventario Almacen"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvPendingCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFEB3B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Main action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_vertical">

        <!-- Button 1: Link new piece -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddNew"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="Vincular pieza nueva"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/primary"
            app:icon="@android:drawable/ic_menu_add"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:cornerRadius="12dp" />

        <!-- Button 2: Register entry/exit -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntryExit"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:text="Registrar Entrada / Salida"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/stock_ok"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:cornerRadius="12dp" />

        <!-- Button 3: Manual entry -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualEntry"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:text="Entrada / Salida manual"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="#FF6D00"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:cornerRadius="12dp" />

        <!-- Button 4: Search products -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:text="Buscar pieza"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="#7B1FA2"
            app:icon="@android:drawable/ic_menu_search"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Setup prompt (shown when not configured) -->
    <LinearLayout
        android:id="@+id/layoutSetupPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configura tu Google Sheets"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pulsa Config para conectar tu hoja de calculo"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:background="@color/surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetup"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Config"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_menu_preferences" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSync"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sincronizar"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_popup_sync" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Historial"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_menu_recent_history" />
    </LinearLayout>

</LinearLayout>
