<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inventario Almacen"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Two big action buttons -->
    <LinearLayout
        android:id="@+id/layoutMainButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <!-- Button 1: Add new piece (link barcode) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddNew"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="Vincular pieza nueva"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/primary"
            app:icon="@android:drawable/ic_menu_add"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:cornerRadius="12dp" />

        <!-- Button 2: Register entry/exit (fast barcode scan) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntryExit"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:text="Registrar Entrada / Salida"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/stock_ok"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Action buttons bar (secondary) -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/surface"
        app:layout_constraintTop_toBottomOf="@id/layoutMainButtons">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetup"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Config"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_menu_preferences" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilter"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filtrar"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_menu_sort_by_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLowStock"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alertas"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_dialog_alert" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Excel"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_menu_save" />
    </LinearLayout>

    <!-- Filter indicator -->
    <TextView
        android:id="@+id/tvFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Filtro: Todos"
        android:textSize="12sp"
        android:background="@color/filter_bg"
        app:layout_constraintTop_toBottomOf="@id/layoutActions" />

    <!-- Setup prompt (shown when not configured) -->
    <LinearLayout
        android:id="@+id/layoutSetupPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvFilter"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configura tu Google Sheets"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pulsa Config para conectar tu hoja de calculo"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Product list -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvFilter"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
